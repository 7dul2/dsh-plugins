{
  "name": "@deepseek-ai/dsh-client-ui-model-retry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用设置中的模型重试次数，复用 Harness 的请求恢复机制",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.spec.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "displayName": "模型重试次数",
      "displayDescription": "在通用设置中修改模型请求失败后的最大重试次数"
    }
  },
  "license": "MIT"
}
